# ===== LLM (OpenAI) =====
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# ===== Embeddings (Open Source) =====
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Once the embedding/reranker models are cached locally (after the first run), set this
# to skip HuggingFace Hub's online version-check — that check can stall for minutes on a
# slow/unreliable connection, which matters a lot when ingesting a large multi-PDF corpus.
# HF_HUB_OFFLINE=1

# ===== Reranker (cross-encoder, used by hybrid retrieval) =====
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ===== Chroma Vector DB (Local) =====
CHROMA_DIR=./chroma_store
CHROMA_COLLECTION=ramayana_kb

# ===== Ingestion defaults =====
PDF_DIR=./data

# ===== Retrieval precision =====
# k: final number of chunks sent to the LLM as context
# fetch_k: candidates pulled per retriever (BM25 + vector) before rerank/filtering
# score_threshold: minimum cross-encoder relevance (0-1) a chunk must clear to be used
RETRIEVAL_K=6
RETRIEVAL_FETCH_K=20
RETRIEVAL_SCORE_THRESHOLD=0.25

# ===== Accounts & sessions =====
# Generate a real one for anything beyond local dev: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
DATABASE_URL=sqlite:///ramayana_helpbot.db
# Origin the frontend runs on — used for CORS and for where OAuth callbacks redirect back to.
FRONTEND_URL=http://localhost:5173
# Set to true once served over HTTPS (required for cookies to survive SameSite=Lax in production).
SESSION_COOKIE_SECURE=false

# ===== OAuth (optional — signup/login still works with email+password if unset) =====
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
#   Authorized redirect URI: http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: developers.facebook.com -> My Apps -> Create App -> Facebook Login product
#   Valid OAuth Redirect URI: http://localhost:8080/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Instagram: Meta retired the standalone consumer "Login with Instagram" flow
# (Instagram Basic Display API) in Dec 2024. There is no equivalent simple
# OAuth login for a personal/consumer app anymore — only Instagram API for
# business/creator accounts via Facebook Login. The UI's Instagram button
# explains this and points users to Google/Facebook instead.

# ===== Server =====
PORT=8080
